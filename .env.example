# Optional email settings for the separate daily_leads.py feature.
# They are not required by main.py.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_PASSWORD=your_app_password_here
RECIPIENT_EMAIL=recipient@example.com

# Scraper configuration
APIFY_TOKEN=your_apify_token
APIFY_ACTOR_ID=harvestapi/linkedin-profile-posts
LINKEDIN_TARGET_URLS=https://www.linkedin.com/company/gcc-marketwatch/,https://www.linkedin.com/company/et-gcc/
APIFY_INITIAL_MAX_POSTS=100
APIFY_MAX_POSTS=20
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_CLOUD_MODEL=gpt-oss:120b

# NOTE: For Gmail, use App Password (not your regular password)
# Generate here: https://myaccount.google.com/apppasswords
# Steps:
# 1. Enable 2FA on your Gmail account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer"
# 4. Generate app password
# 5. Copy the 16-character password and paste as EMAIL_PASSWORD above
